# Copy this file to .env and fill in your key.
# .env is ignored by git (see .gitignore) — NEVER commit it.

# Active LLM provider (optional, default: deepseek). "mistral" switches to
# the Mistral API (compatible with OpenAI function calling) — see below.
# OSINTLLM_PROVIDER=deepseek

# DeepSeek API key — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional (default values below)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Mistral provider (only used if OSINTLLM_PROVIDER=mistral) —
# https://console.mistral.ai/api-keys
# MISTRAL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MISTRAL_BASE_URL=https://api.mistral.ai/v1
# MISTRAL_MODEL=mistral-large-latest

# LLM determinism (optional). Temperature defaults to 0 (factual task); the
# eval path (make eval) also forces a fixed seed.
# OSINTLLM_TEMPERATURE=0
# OSINTLLM_SEED=42

# GitHub token (optional) — enables CODE search (secret detection) and raises
# the Search API quota. Without a token, only repository search works.
# Create a "classic" token with no scopes: https://github.com/settings/tokens
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# VirusTotal key (optional) — enables the virustotal_lookup tool (reputation +
# passive DNS). Free tier with a low quota (~4 req/min, 500/day): the disk
# cache avoids burning it again. Without a key, the tool disables itself cleanly.
# Free key: https://www.virustotal.com/gui/my-apikey
# VT_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Multi-agent verification loop (optional)
# OSINTLLM_MAX_VERIFY=2      # max number of correction round trips (default 2)
# OSINTLLM_VERIFIER_PROVIDER=mistral  # run the verifier on another provider (default: same)

# Disk cache of tool results (optional)
# OSINTLLM_NO_CACHE=1        # disables the cache
# OSINTLLM_CACHE_DIR=.cache  # cache directory
# OSINTLLM_CACHE_TTL=86400   # validity period in seconds (24 h)

# Proxy for ACTIVE reconnaissance (optional). When the user checks
# "Via Tor / proxy", the request that hits the target goes through this proxy.
# Default = local Tor daemon (Tor Browser: use port 9150 instead).
# OSINTLLM_PROXY_URL=socks5h://127.0.0.1:9050

# Eval fixtures (optional) — CLI --record / --replay mode (see main.py).
# Separate from the disk cache above: versioned, no expiry.
# OSINTLLM_FIXTURES_DIR=evals/fixtures
